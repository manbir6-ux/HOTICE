# HOTICE static web preview for Apache/cPanel.
# No admin, AI keys or private application files belong in this directory.
Options -Indexes
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src 'self' https://api.your-hotice-domain.example; media-src 'self' blob:; font-src 'self'; form-action 'self'; frame-ancestors 'none'"
</IfModule>
<FilesMatch "^(\.env|\.htpasswd|composer\.(json|lock)|package(-lock)?\.json|.*\.(bak|sql|key|pem))$">
  Require all denied
</FilesMatch>
